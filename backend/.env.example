# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database (MongoDB)
# Local: mongodb://localhost:27017/handmade-store
# Cloud (Atlas): mongodb+srv://<user>:<password>@cluster0.pepwy4d.mongodb.net/handmade-store?retryWrites=true&w=majority
# ============================================
MONGODB_URI=mongodb://localhost:27017/handmade-store

# ============================================
# Authentication (JWT)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# ============================================
# Cloudinary (Image Storage & Optimization)
# Obtain from https://cloudinary.com/console
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# AI Provider (Google Gemini or OpenAI)
# If using Gemini: Google AI Studio API key (starts with AIzaSy...)
# If using OpenAI: OpenAI API key (starts with sk-...)
# ============================================
AI_API_KEY=your-ai-api-key

# ============================================
# WhatsApp (default fallback — overridden by DB settings)
# Must be in international E.164 format (e.g., +20123456789)
# ============================================
WHATSAPP_NUMBER=+201234567890

# ============================================
# Frontend URL (for CORS allowance)
# In development: http://localhost:5173
# In production: https://your-frontend-deployment.vercel.app
# ============================================
FRONTEND_URL=http://localhost:5173
